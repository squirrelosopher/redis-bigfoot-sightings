# Copy to .env and adjust. Every variable here is optional: the defaults below
# are what the application falls back to, and they are validated at startup.

# --- server ---------------------------------------------------------------
# Used to build links back to the app; keep the scheme so browsers accept it.
SERVER_HOST=http://localhost
SERVER_PORT=8080
# How long a graceful shutdown may take before the process is forced to exit.
SERVER_SHUTDOWN_TIMEOUT_MS=10000

# --- logging --------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- redis ----------------------------------------------------------------
# "redis" is the service name inside Docker Compose.
# Use "127.0.0.1" when running the app directly against a local Redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0

# --- search ---------------------------------------------------------------
SEARCH_INDEX_NAME=sightings-index
# Upper bound a client may request, and the page size used when none is given.
SEARCH_MAX_LIMIT=10000
SEARCH_DEFAULT_LIMIT=5000
# How long the state and county autocomplete lists are cached, in milliseconds.
FACETS_CACHE_TTL_MS=300000

# --- data import ----------------------------------------------------------
DATA_FILE=data/bfro_reports_geocoded.csv
DATA_LOAD_BATCH_SIZE=500
